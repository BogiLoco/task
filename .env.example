# Copy to `.env` and edit as needed; framework/config.py loads it automatically.
# Variables set in the shell or in CI take precedence over `.env`.

# Base URL of the application under test.
BASE_URL=https://qae-assignment-tau.vercel.app

# Your candidate user id. The app authenticates with this plain id only
# (`?user-id=` in the UI, `x-user-id` header in the API); see
# docs/03_strategy_and_recommendations.md for why that matters.
USER_ID=candidate-hUyKPqFY2gaP

# Run Chrome headless ("true") or headed ("false"). Headless is the default
# so the suite runs in CI without a display.
HEADLESS=true
